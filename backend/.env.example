# ══════════════════════════════════════════════════════════════════════════════
# CASPETE / Kidway — Backend Environment Variables Template
# ══════════════════════════════════════════════════════════════════════════════
# Copia este archivo como `.env` y rellena los valores reales.
# NUNCA commits el archivo `.env` — solo este `.env.example`.
# ══════════════════════════════════════════════════════════════════════════════

# ── Base de datos PostgreSQL ──────────────────────────────────────────────────
DATABASE_URL="postgresql://usuario:password@localhost:5432/caspete_bd"

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3001
GPS_TCP_PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── JWT — Generar con: node -e "require('crypto').randomBytes(64).toString('hex')" ──
JWT_SECRET=CAMBIA_ESTO_genera_con_crypto_randomBytes_64_hex
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=CAMBIA_ESTO_genera_con_crypto_randomBytes_64_hex_diferente

# ── Email (Resend) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=info@tudominio.com
PAYMENT_EMAIL=pagos@tudominio.com

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Crear en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ── Monitoreo (Sentry) — Opcional ─────────────────────────────────────────────
# SENTRY_DSN=https://xxxxxxxx@oxxxxxxx.ingest.sentry.io/xxxxxxx

# ── AWS S3 — Backup diario de DB — Opcional ───────────────────────────────────
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_REGION=us-east-1
# S3_BACKUP_BUCKET=nombre-de-tu-bucket

# ── Nequi Push Payments — Opcional ────────────────────────────────────────────
# NEQUI_API_URL=https://api.sandbox.nequi.com
# NEQUI_CLIENT_ID=
# NEQUI_CLIENT_SECRET=

# ── Plataforma GPS Externa — Opcional ─────────────────────────────────────────
# GPS_PLATFORM_API_URL=https://gps.tudominio.com/api/v1
# GPS_PLATFORM_API_KEY=
